# DOT-Copilot Root Environment Variables

# -----------------------------------------------------------------------------
# CANONICAL BACKEND (Express + Prisma)
# Location: cursor-projects/DOT-Copilot/backend
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dot_copilot?schema=public"
PORT=3001
NODE_ENV=development
JWT_SECRET="your-super-secret-jwt-key-at-least-32-characters"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Optional: External Services
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="noreply@dot-copilot.com"

# -----------------------------------------------------------------------------
# CANONICAL FRONTEND (React + Vite)
# Location: root (/)
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:3001/api

# Optional: Supabase (if used for direct storage/auth)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# -----------------------------------------------------------------------------
# INFRASTRUCTURE & CLOUD (Azure)
# -----------------------------------------------------------------------------
AZURE_SUBSCRIPTION_ID="05b74b10-62fd-49af-8ad2-021931ad5f94"
AZURE_TENANT_ID=
AZURE_CLIENT_ID=

# -----------------------------------------------------------------------------
# MCP GATEWAY & AUTOMATION
# -----------------------------------------------------------------------------
COMPOSIO_API_KEY=
REDIS_URL=redis://localhost:6379/1
SLACK_ADMIN_CHANNEL=compliance-alerts
